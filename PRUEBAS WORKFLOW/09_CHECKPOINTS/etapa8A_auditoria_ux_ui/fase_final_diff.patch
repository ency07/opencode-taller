+    var ta = $('mpPrompt');
+    if (ta) ta.value = r.prompt || '';
+    var meta = $('mpMeta');
+    if (meta) {
+      meta.textContent = r.producto + ' · ' + (r.ok ? 'OK' : 'ERROR')
+        + ' · ' + String(r.prompt || '').length + ' caracteres'
+        + (r.context ? (' · contexto ' + (r.context.market || '—') + '/' + (r.context.region || '—') + '/' + r.producto) : '')
+        + (r.error ? (' · ' + truncar(r.error, 80)) : '');
