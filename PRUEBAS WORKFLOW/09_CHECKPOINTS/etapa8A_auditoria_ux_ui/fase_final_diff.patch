+    var leftCol = mp.parentElement;
+
+    var config = document.createElement('div');
+    config.className = 'tp-scope';
+    config.id = 'tpConfig';
+
+    var titulos = {
+      contexto: 'Contexto',
+      producto: 'Producto e impresión',
+      idea: 'La idea',
