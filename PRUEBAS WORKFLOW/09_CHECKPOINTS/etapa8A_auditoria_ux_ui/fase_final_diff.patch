+    return new Promise(function (resolve) {
+      var hecho = false;
+      function fin() { if (!hecho) { hecho = true; resolve(); } }
+      try {
+        if (window.requestAnimationFrame) window.requestAnimationFrame(fin);
+        else setTimeout(fin, 16);
+      } catch (e) { setTimeout(fin, 16); }
+      setTimeout(fin, 150);
+    });
+  }
