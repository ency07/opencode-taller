+      normalizado: {
+        id: null,
+        createdAt: lote.createdAt || _fechaNueva(),
+        ctx: ctx,
+        productos: productos,
+        total: productos.length,
+        ok: errores === 0,
+        errores: errores
+      }
+    };
+  }
+
+  /* Guarda un lote. No sobrescribe lotes anteriores: cada guardado crea uno
+     nuevo; con `deduplicar` (por defecto) un lote idéntico al último no se
