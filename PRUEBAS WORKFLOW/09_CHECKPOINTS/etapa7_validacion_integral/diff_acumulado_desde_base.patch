+    var json = JSON.stringify(registro);
+    if (_bytes(json) > PRESUPUESTO_BYTES) {
+      return { ok: false, error: 'lote demasiado grande para el presupuesto (' + _bytes(json) + ' bytes)', rotados: [] };
