+    var nombreZip = 'lote-multiproducto-' + id + '.zip';
+    var out = {
+      ok: true,
+      bytes: bytes,
+      nombre: opciones.nombre || nombreZip,
+      tamano: bytes.length,
+      archivos: nombres,
+      crc: archivos.map(function (a) { return { nombre: a.nombre, crc: a.crc }; })
+    };
